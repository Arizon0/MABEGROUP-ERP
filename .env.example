# ============================================================================
# Marketplace Hub — variáveis de ambiente
#
# Copie para `.env` e ajuste. NUNCA versione o `.env` preenchido: um token de
# marketplace vazado dá acesso de escrita à conta do vendedor (alterar preços,
# encerrar anúncios, responder clientes).
# ============================================================================

# --- Aplicação --------------------------------------------------------------
ENVIRONMENT=local              # local | test | staging | production
LOG_LEVEL=INFO
DEBUG=0

# --- Banco de dados ---------------------------------------------------------
# Produção (serviço gerenciado — ver docs/01-arquitetura.md §1.6):
#   postgresql+asyncpg://usuario:senha@host:5432/banco
# Desenvolvimento sem Postgres instalado:
DATABASE_URL=sqlite+aiosqlite:///./marketplace_hub.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis (fila, cache e pub/sub do painel ao vivo) ------------------------
# Vazio = modo degradado com barramento em memória (só funciona em processo
# único; sem ele, os eventos não chegam ao painel a partir do worker).
REDIS_URL=redis://localhost:6379/0

# --- Segurança --------------------------------------------------------------
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cofre de tokens de marketplace. OBRIGATÓRIA em produção.
# Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=

# Sal da pseudonimização do identificador de comprador (LGPD).
BUYER_HASH_PEPPER=troque-este-valor-em-producao

# Em produção, liste as origens explicitamente (nunca "*").
CORS_ORIGINS=http://localhost:5173

# --- Mercado Livre ----------------------------------------------------------
# Crie a aplicação em https://developers.mercadolivre.com.br/devcenter
# A Redirect URI precisa bater caractere por caractere com a cadastrada lá.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:8000/api/v1/oauth/mercadolivre/callback

# --- Mercado Pago -----------------------------------------------------------
# Necessário apenas se o vendedor receber por fora do Mercado Livre; o token do
# ML já autoriza boa parte de /v1/payments.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=http://localhost:8000/api/v1/oauth/mercadopago/callback
# Segredo do webhook (painel do MP → Suas integrações → Webhooks).
MP_WEBHOOK_SECRET=

# --- Shopee -----------------------------------------------------------------
# Crie o app em https://open.shopee.com
# Atenção: o relógio do servidor precisa estar sincronizado (NTP). A Shopee
# rejeita requisições com timestamp fora de ±5 minutos.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/shopee/callback
# Sandbox: https://partner.test-stable.shopeemobile.com
SHOPEE_API_BASE=https://partner.shopeemobile.com

# --- Integração -------------------------------------------------------------
# 1 = conectores simulados, nenhuma chamada sai para a internet. É o que
# permite rodar o projeto inteiro sem credencial nenhuma.
USE_MOCK_CONNECTORS=1
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=4
RATE_LIMIT_PER_MINUTE=300
WEBHOOK_MAX_ATTEMPTS=6
SYNC_OVERLAP_MINUTES=5
BACKFILL_DAYS=90

# --- Conciliação ------------------------------------------------------------
# Tolerância em reais para considerar um pedido conciliado (arredondamento).
RECONCILIATION_TOLERANCE=0.01

# --- Observabilidade --------------------------------------------------------
SENTRY_DSN=
METRICS_ENABLED=1

# --- Usuário inicial (criado no primeiro start fora de produção) ------------
SEED_ON_STARTUP=1
ADMIN_EMAIL=admin@marketplacehub.com.br
ADMIN_PASSWORD=admin123
ADMIN_TENANT=Demonstração
